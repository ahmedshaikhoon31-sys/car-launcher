<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- brushed-silver crest ring with a faint inner sheen -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#22FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
            <stroke
                android:width="3dp"
                android:color="#D7DCE3" />
        </shape>
    </item>
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#55D7DCE3" />
        </shape>
    </item>
</layer-list>
