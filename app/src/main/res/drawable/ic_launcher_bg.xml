<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#081120"
                android:centerColor="#0E2C4C"
                android:endColor="#134A6E"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.34"
                android:gradientRadius="140"
                android:startColor="#553DD8E0"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
