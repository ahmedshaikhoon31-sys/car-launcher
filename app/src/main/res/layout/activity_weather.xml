<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="26dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/btn_circle"
        android:contentDescription="@string/back"
        android:rotationY="180"
        android:src="@drawable/ic_prev"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bigIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        android:contentDescription="weather"
        android:src="@drawable/ic_cloud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/bigTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:fontFamily="sans-serif-thin"
        android:text="--°"
        android:textColor="@color/text_primary"
        android:textSize="64sp"
        app:layout_constraintBottom_toBottomOf="@id/bigIcon"
        app:layout_constraintStart_toEndOf="@id/bigIcon"
        app:layout_constraintTop_toTopOf="@id/bigIcon" />

    <TextView
        android:id="@+id/cityDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:text="القاهرة"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/bigIcon"
        app:layout_constraintTop_toBottomOf="@id/bigIcon" />

    <TextView
        android:id="@+id/hourlyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/hourly"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cityDesc" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hoursList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hourlyTitle"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="6"
        tools:listitem="@layout/item_hour" />

</androidx.constraintlayout.widget.ConstraintLayout>
