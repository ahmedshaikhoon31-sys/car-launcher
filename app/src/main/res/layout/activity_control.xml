<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.zarwa.launcher.AuroraView
        android:id="@+id/aurora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_margin="22dp"
        android:background="@drawable/btn_circle"
        android:contentDescription="@string/back"
        android:rotationY="180"
        android:src="@drawable/ic_prev"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="720dp"
        android:layout_marginHorizontal="60dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/control_center"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <!-- Brightness -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/brightness"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekBright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="255"
            android:progressTint="?attr/accent"
            android:thumbTint="?attr/accent" />

        <!-- Volume -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/volume"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekVol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:progressTint="?attr/accent"
            android:thumbTint="?attr/accent" />

        <!-- Auto night -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/auto_night"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Quick buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileSpeed"
                style="@style/ControlTile">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_speed" />

                <TextView
                    style="@style/ControlTileLabel"
                    android:text="@string/speedometer" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileWifi"
                style="@style/ControlTile"
                android:layout_marginStart="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    style="@style/ControlTileLabel"
                    android:text="@string/wifi" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileBt"
                style="@style/ControlTile"
                android:layout_marginStart="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bluetooth" />

                <TextView
                    style="@style/ControlTileLabel"
                    android:text="@string/bluetooth" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileSettings"
                style="@style/ControlTile"
                android:layout_marginStart="12dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings" />

                <TextView
                    style="@style/ControlTileLabel"
                    android:text="@string/settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
